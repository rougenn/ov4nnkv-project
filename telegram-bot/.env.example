# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# AI Agent Configuration
# Локально: http://localhost:10000
# Удалённо: укажите свой публичный A2A endpoint
AGENT_API_URL=http://localhost:10000

# Optional settings
HANDLE_MESSAGE_EDITS=true
EDIT_RESPONSE_TIMEOUT=30
# Автоподключение к агенту при /start (без лишних кликов)
AUTO_CONNECT_ON_START=true
