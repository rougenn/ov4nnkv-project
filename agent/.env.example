# =================================
# LLM (OpenRouter)
# =================================
# Получить ключ: https://openrouter.ai/keys
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-openrouter-key-here
LLM_MODEL=openai/gpt-4o-mini

# Опционально: для аналитики OpenRouter (можно оставить пустым)
OPENROUTER_SITE_URL=https://github.com/your-org/meeting-assistant
OPENROUTER_APP_NAME=Meeting Assistant

# =================================
# MCP Servers URLs
# =================================
# Follow-Up MCP — запись и транскрибация созвонов
FOLLOWUP_MCP_URL=http://localhost:8000/mcp

# Google Calendar MCP — управление календарём
GCALENDAR_MCP_URL=http://localhost:8001/mcp

# Managed RAG MCP — поиск по транскрипциям
MANAGED_RAG_MCP_URL=http://localhost:8002/mcp

# =================================
# Agent Configuration
# =================================
AGENT_NAME=Meeting Assistant
AGENT_DESCRIPTION=AI-ассистент для работы с корпоративными созвонами
AGENT_VERSION=1.0.0
PORT=10000

# A2A Protocol
URL_AGENT=http://localhost:10000

# Telemetry (optional)
ENABLE_PHOENIX=false

# Logging
LOG_LEVEL=INFO
