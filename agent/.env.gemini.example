# Пресет для Google Gemini (через OpenAI-совместимый endpoint).
# Включить Gemini API в Cloud Console:
#   https://console.developers.google.com/apis/api/generativelanguage.googleapis.com/overview
# Получить API key (формат AIzaSy…):
#   https://aistudio.google.com/apikey

LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=AIzaSy-your-gemini-api-key
LLM_MODEL=gemini-2.0-flash
# Альтернативы:
#   gemini-2.5-flash       — быстрее, дешевле
#   gemini-2.5-pro         — мощнее, дороже
#   gemini-1.5-flash-002   — стабильный legacy
